{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-11-18",
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Room",
        "name": "Room"
      }
    ]
  },
  "main": "src/server.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "Room"
      ],
      "tag": "v1"
    }
  ],
  "name": "minigames-party",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "party.ices.my.id",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "IMAGES",
      "id": "84b2744e90684ebb9cf47455443af212"
    }
  ]
}
